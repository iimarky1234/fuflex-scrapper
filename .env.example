# Browserbase API key (required for `browse --remote`)
# Get yours from https://www.browserbase.com/settings
BROWSERBASE_API_KEY=bb_live_your_api_key_here

# Target exam (from URL: https://www.fuflex.site/exams/<EXAM_ID>/images?subject=<SUBJECT>)
FUFLEX_EXAM_ID=3671
FUFLEX_SUBJECT=APO201C

# FUFLEX session values from browser DevTools -> Application tab
# Local Storage:
FUFLEX_TOKEN=your_fuflex_token_here
FUFLEX_VISITOR_ID=your_fuflex_visitor_id_here

# Cookies:
FUFLEX_FX_TRUST=your_fx_trust_cookie_here
FUFLEX_FX_DID=your_fx_did_cookie_here
FUFLEX_FX_AUTH=your_fx_auth_cookie_here
